<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI Sign Language Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        :root {
            --primary: #0ea5e9;
            --secondary: #06b6d4;
            --bg-color: #f8fafc;
        }

        body {
            font-family: 'Prompt', sans-serif;
            background-color: var(--bg-color);
            /* Simplified Background for Performance */
            background-image: linear-gradient(to bottom right, #f0f9ff, #e0f2fe);
            color: #1e293b;
            -webkit-tap-highlight-color: transparent;
            overflow-x: hidden;
        }

        /* Fast Glass - No Blur, High Opacity */
        .fast-glass {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        /* Scrollbar Hiding */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Custom Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 4px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

        .card-hover { 
            transition: transform 0.15s ease, box-shadow 0.15s ease;
            will-change: transform; /* Hint for browser optimization */
        }
        .card-hover:active { 
            transform: scale(0.98); 
        }

        /* Optimized Modal Transitions */
        .modal-backdrop {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease-out;
            background: rgba(0, 0, 0, 0.5); /* Simple dark overlay */
        }
        .modal-backdrop.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            transform: translateY(100%);
            transition: transform 0.25s cubic-bezier(0.2, 0, 0.2, 1);
            will-change: transform;
        }
        
        /* Desktop: Center Modal */
        @media (min-width: 768px) {
            .modal-content {
                transform: scale(0.95);
                opacity: 0;
                transition: transform 0.2s ease-out, opacity 0.2s ease-out;
            }
            .modal-backdrop.active .modal-content {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* Mobile: Bottom Sheet */
        @media (max-width: 767px) {
            .modal-backdrop.active .modal-content {
                transform: translateY(0);
            }
        }

        /* Simple Skeleton */
        .skeleton {
            background-color: #e2e8f0;
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .7; }
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <!-- Header -->
    <header class="fast-glass z-30 flex-none border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-sky-500 p-2 rounded-lg text-white shadow-sm">
                    <i data-lucide="scan-face" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-bold text-slate-800 leading-tight">AI Sign Lab</h1>
                    <p class="text-[10px] text-slate-500 font-medium tracking-wider">LITE VERSION</p>
                </div>
            </div>

            <!-- Desktop Search -->
            <div class="hidden md:block flex-1 max-w-md relative group">
                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-slate-400">
                    <i data-lucide="search" class="w-4 h-4"></i>
                </div>
                <input type="text" id="searchInputDesktop" 
                    class="w-full pl-10 pr-4 py-2 bg-slate-100 border-none rounded-lg focus:ring-2 focus:ring-sky-500 focus:bg-white transition-colors text-sm placeholder-slate-400"
                    placeholder="ค้นหาคำศัพท์... (เช่น ก ไก่)">
            </div>

            <!-- Mobile Search Toggle -->
            <button onclick="document.getElementById('mobileSearchPanel').classList.toggle('hidden')" class="md:hidden p-2 text-slate-600 bg-slate-100 rounded-lg active:bg-slate-200">
                <i data-lucide="search" class="w-5 h-5"></i>
            </button>
        </div>
        
        <!-- Mobile Search Panel -->
        <div id="mobileSearchPanel" class="hidden px-4 pb-3 md:hidden">
            <div class="relative">
                <input type="text" id="searchInputMobile" 
                    class="w-full pl-10 pr-4 py-2.5 bg-slate-100 border-none rounded-lg focus:ring-2 focus:ring-sky-500 text-sm"
                    placeholder="ค้นหาคำศัพท์...">
                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-slate-400">
                    <i data-lucide="search" class="w-4 h-4"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-hidden relative flex flex-col md:flex-row max-w-7xl mx-auto w-full">
        
        <!-- Category Sidebar -->
        <aside class="w-full md:w-64 md:h-full flex-none bg-white md:bg-transparent border-b md:border-b-0 md:border-r border-slate-200 z-20">
            <div class="p-3 md:p-4 h-full flex md:flex-col overflow-x-auto md:overflow-y-auto no-scrollbar gap-2 md:gap-1 snap-x">
                <div class="md:px-2 md:py-3 text-xs font-bold text-slate-400 uppercase tracking-widest hidden md:block">Categories</div>
                <div id="categoryContainer" class="flex md:flex-col gap-2">
                    <!-- Skeletons -->
                    <div class="h-9 w-24 md:w-full rounded-lg skeleton shrink-0"></div>
                    <div class="h-9 w-24 md:w-full rounded-lg skeleton shrink-0"></div>
                </div>
            </div>
        </aside>

        <!-- Grid Content -->
        <div class="flex-1 overflow-y-auto custom-scroll p-4 md:p-6" id="mainScroll">
            <!-- Banner -->
            <div class="mb-6 p-5 rounded-xl bg-sky-600 text-white shadow-md hidden md:block">
                <h2 class="text-xl font-bold mb-1">ยินดีต้อนรับ</h2>
                <p class="text-sky-100 text-sm">ระบบเรียนรู้ภาษามือแบบรวดเร็ว</p>
            </div>

            <!-- Content Grid -->
            <div id="contentGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 md:gap-4 pb-24">
                <!-- Skeletons injected by JS -->
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden flex flex-col items-center justify-center py-20 text-center">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4">
                    <i data-lucide="search-x" class="w-8 h-8 text-slate-400"></i>
                </div>
                <h3 class="text-base font-bold text-slate-600">ไม่พบข้อมูล</h3>
            </div>
        </div>

    </main>

    <!-- Chatbot Button -->
    <div class="fixed bottom-6 right-6 z-50">
        <button onclick="toggleChat()" class="bg-sky-600 text-white p-4 rounded-full shadow-lg hover:bg-sky-700 active:scale-95 transition-transform">
            <i data-lucide="bot" class="w-6 h-6"></i>
        </button>
    </div>

    <!-- Chatbot Window (Simplified) -->
    <div id="chatbotWindow" class="fixed bottom-24 right-4 md:right-6 w-[92vw] md:w-80 h-[50vh] md:h-[450px] bg-white border border-slate-200 rounded-xl shadow-xl flex flex-col translate-y-10 opacity-0 pointer-events-none transition-all duration-200 z-40 origin-bottom-right">
        <div class="p-3 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-xl">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                <span class="font-bold text-slate-700 text-sm">AI Tutor</span>
            </div>
            <button onclick="toggleChat()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div id="chatMessages" class="flex-1 overflow-y-auto p-3 space-y-3 text-sm custom-scroll bg-white">
            <div class="flex gap-2">
                <div class="bg-slate-100 p-2.5 rounded-xl rounded-tl-none border border-slate-200 max-w-[90%] text-slate-700">
                    สวัสดีครับ สงสัยคำไหนถามได้เลยครับ 🤖
                </div>
            </div>
        </div>

        <div class="p-2 border-t border-slate-100">
            <div class="flex gap-2">
                <input type="text" id="chatInput" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-sky-500 text-sm" placeholder="พิมพ์ข้อความ...">
                <button onclick="sendChat()" class="px-3 bg-sky-600 text-white rounded-lg flex items-center justify-center">
                    <i data-lucide="send" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- OPTIMIZED DIALOG / MODAL -->
    <div id="detailModal" class="fixed inset-0 z-[100] modal-backdrop flex items-end md:items-center justify-center">
        <!-- Overlay -->
        <div class="absolute inset-0" onclick="closeModal()"></div>
        
        <!-- Content -->
        <div class="modal-content relative w-full md:w-[500px] bg-white md:rounded-xl rounded-t-2xl shadow-2xl flex flex-col max-h-[85vh] overflow-hidden">
            
            <!-- Mobile Drag Handle -->
            <div class="md:hidden w-full flex justify-center pt-3 pb-1" onclick="closeModal()">
                <div class="w-10 h-1 bg-slate-300 rounded-full"></div>
            </div>

            <!-- Header -->
            <div class="px-5 py-3 border-b border-slate-100 flex justify-between items-center bg-white z-10 sticky top-0">
                <div>
                    <span id="mCategory" class="text-[10px] font-bold text-sky-600 bg-sky-50 px-2 py-0.5 rounded uppercase tracking-wider">Category</span>
                    <div class="flex items-baseline gap-2 mt-1">
                        <h2 id="mWord" class="text-xl font-bold text-slate-800">Word</h2>
                        <span id="mWordEn" class="text-sm text-slate-400 font-medium">En</span>
                    </div>
                </div>
                <button onclick="closeModal()" class="p-2 bg-slate-100 rounded-full text-slate-500 hover:bg-slate-200">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Scroll Area -->
            <div class="overflow-y-auto custom-scroll p-0 pb-6 bg-white">
                
                <!-- Media -->
                <div class="relative w-full aspect-video bg-slate-100">
                    <img id="mImage" src="" class="w-full h-full object-contain transition-opacity duration-200">
                    
                    <div id="mVideoContainer" class="absolute inset-0 hidden bg-black">
                        <iframe id="mYoutube" class="w-full h-full" src="" frameborder="0" allowfullscreen></iframe>
                    </div>

                    <button id="viewToggleBtn" onclick="toggleMediaView()" class="absolute bottom-3 right-3 bg-white text-slate-800 px-3 py-1.5 rounded-md shadow-md text-xs font-bold flex items-center gap-2 border border-slate-200">
                        <i data-lucide="play-circle" class="w-4 h-4 text-red-500"></i>
                        <span>ดูวิดีโอ</span>
                    </button>
                </div>

                <!-- Info -->
                <div class="p-5 space-y-4">
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100">
                        <div class="flex items-center gap-2 mb-2 text-sky-600">
                            <i data-lucide="info" class="w-4 h-4"></i>
                            <span class="text-xs font-bold uppercase">วิธีทำ</span>
                        </div>
                        <p id="mDesc" class="text-slate-700 leading-relaxed text-sm">Description...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const DATA_URL = './signs500.json'; 
        const BACKEND_URL = 'https://quiet-scene-f18b.tontakankeawpang321.workers.dev';
        
        let state = {
            data: [],
            filtered: [],
            categories: ['ทั้งหมด'],
            activeCategory: 'ทั้งหมด',
            searchTerm: '',
            isVideoMode: false,
            currentVideoId: null
        };

        const MOCK_DATA = [
            { word: 'ก ไก่', word_en: 'Ko Kai', category: 'หมวด ก-ฮ', description: 'กำมือขวาชูขึ้น ระดับไหล่ หันฝ่ามือไปทางซ้าย ขยับนิ้วชี้และนิ้วกลางลงมาชนนิ้วโป้ง 2 ครั้ง (เลียนแบบปากไก่)', imageUrl: 'https://placehold.co/600x400/f1f5f9/0ea5e9?text=ก+ไก่', youtubeUrl: 'https://www.youtube.com/watch?v=VIDEO_ID' },
            { word: 'ข ไข่', word_en: 'Kho Khai', category: 'หมวด ก-ฮ', description: 'กำมือขวา วาดเป็นวงกลมในอากาศ เหมือนรูปไข่', imageUrl: 'https://placehold.co/600x400/f1f5f9/0ea5e9?text=ข+ไข่', youtubeUrl: '' }
        ];

        document.addEventListener('DOMContentLoaded', async () => {
            renderSkeletons();
            await loadData();
            initSearch();
            lucide.createIcons();
        });

        async function loadData() {
            try {
                const response = await fetch(DATA_URL).catch(() => null);
                if (response && response.ok) {
                    state.data = await response.json();
                } else {
                    state.data = MOCK_DATA;
                }
            } catch (e) {
                state.data = MOCK_DATA;
            }

            const rawCats = [...new Set(state.data.map(d => d.category || 'ทั่วไป'))];
            state.categories = ['ทั้งหมด', ...rawCats.sort()];

            renderCategories();
            filterData();
        }

        function filterData() {
            const term = state.searchTerm.toLowerCase();
            state.filtered = state.data.filter(item => {
                const matchCat = state.activeCategory === 'ทั้งหมด' || (item.category || 'ทั่วไป') === state.activeCategory;
                const matchSearch = (item.word?.toLowerCase().includes(term)) || (item.word_en?.toLowerCase().includes(term));
                return matchCat && matchSearch;
            });
            renderGrid();
        }

        function renderSkeletons() {
            const grid = document.getElementById('contentGrid');
            grid.innerHTML = Array(10).fill(0).map(() => `
                <div class="bg-white rounded-lg overflow-hidden border border-slate-200 h-48 flex flex-col">
                    <div class="h-32 skeleton w-full"></div>
                    <div class="p-3 space-y-2 flex-1">
                        <div class="h-4 w-3/4 skeleton rounded"></div>
                    </div>
                </div>
            `).join('');
        }

        function renderCategories() {
            const container = document.getElementById('categoryContainer');
            container.innerHTML = state.categories.map(cat => `
                <button onclick="selectCategory('${cat}')" 
                    class="${state.activeCategory === cat 
                        ? 'bg-sky-600 text-white shadow-sm' 
                        : 'bg-white text-slate-600 border border-slate-200'} 
                    flex-shrink-0 px-4 py-2 rounded-lg text-xs font-semibold transition-colors md:w-full md:text-left whitespace-nowrap">
                    ${cat}
                </button>
            `).join('');
        }

        function renderGrid() {
            const grid = document.getElementById('contentGrid');
            const empty = document.getElementById('emptyState');
            
            if (state.filtered.length === 0) {
                grid.innerHTML = '';
                empty.classList.remove('hidden');
                return;
            }
            empty.classList.add('hidden');

            grid.innerHTML = state.filtered.map((item, index) => `
                <div onclick="openDetail(${index})" class="group bg-white rounded-xl overflow-hidden cursor-pointer card-hover border border-slate-200 shadow-sm relative">
                    <div class="h-32 md:h-40 overflow-hidden bg-slate-100 relative">
                        <img src="${item.imageUrl}" 
                             alt="${item.word}" 
                             loading="lazy"
                             class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                             onerror="this.src='https://placehold.co/400x300/f1f5f9/cbd5e1?text=No+Image'">
                        
                        <div class="absolute bottom-2 left-2 bg-white/95 px-2 py-0.5 rounded text-[10px] font-bold text-sky-600 shadow-sm border border-slate-100 uppercase tracking-wide">
                            ${item.category || 'ทั่วไป'}
                        </div>
                    </div>
                    
                    <div class="p-3 bg-white h-full border-t border-slate-100">
                        <h3 class="font-bold text-slate-800 text-sm md:text-base leading-tight mb-0.5 truncate">${item.word}</h3>
                        <p class="text-[10px] text-slate-400 uppercase tracking-wide truncate">${item.word_en || ''}</p>
                    </div>
                </div>
            `).join('');
            
            lucide.createIcons();
        }

        window.selectCategory = (cat) => {
            state.activeCategory = cat;
            renderCategories();
            filterData();
            if(window.innerWidth < 768) {
                document.getElementById('contentGrid').scrollIntoView({behavior: 'smooth', block: 'start'});
            }
        };

        function initSearch() {
            const handleSearch = (e) => {
                state.searchTerm = e.target.value;
                filterData();
            };
            let timeout;
            const debouncedSearch = (e) => {
                clearTimeout(timeout);
                timeout = setTimeout(() => handleSearch(e), 300);
            };

            document.getElementById('searchInputDesktop').addEventListener('input', debouncedSearch);
            document.getElementById('searchInputMobile').addEventListener('input', debouncedSearch);
        }

        // --- Simplified Modal Logic ---
        window.openDetail = (index) => {
            const item = state.filtered[index];
            const modal = document.getElementById('detailModal');
            
            document.getElementById('mCategory').innerText = item.category || 'General';
            document.getElementById('mWord').innerText = item.word;
            document.getElementById('mWordEn').innerText = item.word_en || '-';
            document.getElementById('mDesc').innerText = item.description || 'ไม่มีคำอธิบาย';
            document.getElementById('mImage').src = item.imageUrl;
            
            state.currentVideoId = null;
            if (item.youtubeUrl) {
                const match = item.youtubeUrl.match(/(?:v=|\/embed\/|youtu\.be\/)([^&?#]+)/);
                if (match) state.currentVideoId = match[1];
            }

            const toggleBtn = document.getElementById('viewToggleBtn');
            toggleBtn.style.display = state.currentVideoId ? 'flex' : 'none';

            resetMediaView();
            modal.classList.add('active');
            document.body.style.overflow = 'hidden'; 
        };

        window.closeModal = () => {
            const modal = document.getElementById('detailModal');
            modal.classList.remove('active');
            document.getElementById('mYoutube').src = "";
            document.body.style.overflow = '';
        };

        window.toggleMediaView = () => {
            const img = document.getElementById('mImage');
            const vidContainer = document.getElementById('mVideoContainer');
            const iframe = document.getElementById('mYoutube');
            const btnText = document.querySelector('#viewToggleBtn span');

            state.isVideoMode = !state.isVideoMode;

            if (state.isVideoMode) {
                img.classList.add('opacity-0');
                vidContainer.classList.remove('hidden');
                iframe.src = `https://www.youtube.com/embed/${state.currentVideoId}?autoplay=1&rel=0`;
                btnText.innerText = 'ดูรูปภาพ';
            } else {
                img.classList.remove('opacity-0');
                vidContainer.classList.add('hidden');
                iframe.src = ""; 
                btnText.innerText = 'ดูวิดีโอ';
            }
        };

        function resetMediaView() {
            state.isVideoMode = false;
            document.getElementById('mImage').classList.remove('opacity-0');
            document.getElementById('mVideoContainer').classList.add('hidden');
            document.getElementById('mYoutube').src = "";
            const btn = document.querySelector('#viewToggleBtn span');
            if(btn) btn.innerText = 'ดูวิดีโอ';
        }

        // --- Chatbot Logic ---
        let chatHistory = [];
        
        window.toggleChat = () => {
            const win = document.getElementById('chatbotWindow');
            const isOpen = win.classList.contains('opacity-100');
            
            if (isOpen) {
                win.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
                win.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
            } else {
                win.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
                win.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
                setTimeout(() => document.getElementById('chatInput').focus(), 100);
            }
        };

        window.sendChat = async () => {
            const input = document.getElementById('chatInput');
            const text = input.value.trim();
            if (!text) return;

            addChatBubble(text, 'user');
            input.value = '';
            
            try {
                const res = await fetch(BACKEND_URL, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ history: [...chatHistory, {role: "user", parts: [{text: text}]}] })
                });
                
                if (res.ok) {
                    const data = await res.json();
                    addChatBubble(data.reply, 'ai');
                    chatHistory.push({role: "user", parts: [{text}]}, {role: "model", parts: [{text: data.reply}]});
                } else {
                    throw new Error("Backend failed");
                }
            } catch (err) {
                setTimeout(() => {
                    let reply = "ขออภัยครับ ระบบออฟไลน์ชั่วคราว";
                    if(text.includes('สวัสดี')) reply = "สวัสดีครับ มีอะไรให้ช่วยไหมครับ?";
                    addChatBubble(reply, 'ai');
                }, 600);
            }
        };

        document.getElementById('chatInput').addEventListener('keypress', (e) => {
            if(e.key === 'Enter') sendChat();
        });

        function addChatBubble(text, type) {
            const container = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = "flex gap-2 " + (type === 'user' ? "flex-row-reverse" : "");
            
            const bgClass = type === 'user' ? 'bg-sky-600 text-white' : 'bg-slate-100 text-slate-700 border border-slate-200';

            div.innerHTML = `
                <div class="${bgClass} px-3 py-2 rounded-xl max-w-[85%] text-sm shadow-sm">
                    ${text}
                </div>
            `;
            
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

    </script>
</body>
</html>
